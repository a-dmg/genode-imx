# FIT image support
CONFIG_FIT=y
CONFIG_FIT_BEST_MATCH=n
CONFIG_FIT_CIPHER=n
CONFIG_FIT_EXTERNAL_OFFSET=0x3000
CONFIG_FIT_FULL_CHECK=y
CONFIG_FIT_PRINT=y
CONFIG_FIT_PRINT=y
CONFIG_FIT_RSASSA_PSS=n
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_SIGNATURE_MAX_SIZE=0x10000000
CONFIG_FIT_VERBOSE=n
CONFIG_SPL_FIT=y
CONFIG_SPL_FIT_FULL_CHECK=n
CONFIG_SPL_FIT_IMAGE_POST_PROCESS=n
CONFIG_SPL_FIT_IMAGE_TINY=y
CONFIG_SPL_FIT_PRINT=n
CONFIG_SPL_FIT_SIGNATURE=n
CONFIG_SPL_FIT_SOURCE=""
CONFIG_SPL_LOAD_FIT=y
CONFIG_SPL_LOAD_FIT_ADDRESS=0x0
CONFIG_SPL_LOAD_FIT_APPLY_OVERLAY=n
CONFIG_SPL_LOAD_FIT_FULL=n
CONFIG_SPL_MULTI_DTB_FIT=n
CONFIG_TOOLS_FIT=y
CONFIG_TOOLS_FIT_FULL_CHECK=y
CONFIG_TOOLS_FIT_PRINT=y
CONFIG_TOOLS_FIT_RSASSA_PSS=y
CONFIG_TOOLS_FIT_SIGNATURE=y
CONFIG_TOOLS_FIT_SIGNATURE_MAX_SIZE=0x10000000
CONFIG_TOOLS_FIT_VERBOSE=y
CONFIG_USE_SPL_FIT_GENERATOR=n
# Boot Commands
CONFIG_CMD_BOOTD=n
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTZ=n
CONFIG_CMD_BOOTI=n
CONFIG_BOOTM_LINUX=y
CONFIG_BOOTM_NETBSD=n
CONFIG_BOOTM_OPENRTOS=n
CONFIG_BOOTM_OSE=n
CONFIG_BOOTM_PLAN9=n
CONFIG_BOOTM_RTEMS=n
CONFIG_BOOTM_EFI=n
CONFIG_CMD_VBE=n
CONFIG_CMD_BOOTFLOW_FULL=n
# Boot mehtode
CONFIG_PXE_UTILS=y
CONFIG_BOOT_DEFAULTS_FEATURES=y
CONFIG_BOOT_DEFAULTS_CMDS=y
CONFIG_BOOT_DEFAULTS=y
CONFIG_BOOTSTD=y
CONFIG_SPL_BOOTSTD=n
CONFIG_BOOTSTD_FULL=y
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_BOOTSTD_BOOTCOMMAND=y
CONFIG_BOOTMETH_GLOBAL=y
CONFIG_BOOTMETH_CROS=n
CONFIG_BOOTMETH_EXTLINUX=y
CONFIG_BOOTMETH_EXTLINUX_PXE=y
CONFIG_BOOTMETH_EFILOADER=y
CONFIG_BOOTMETH_VBE=y
CONFIG_BOOTMETH_DISTRO=y
CONFIG_SPL_BOOTMETH_VBE=n
CONFIG_BOOTMETH_VBE_REQUEST=y
CONFIG_SPL_BOOTMETH_VBE_REQUEST=n
CONFIG_BOOTMETH_VBE_SIMPLE=y
CONFIG_BOOTMETH_VBE_SIMPLE_OS=y
CONFIG_SPL_BOOTMETH_VBE_SIMPLE=n
CONFIG_BOOTMETH_SCRIPT=y
CONFIG_LEGACY_IMAGE_FORMAT=n
CONFIG_MEASURED_BOOT=y
CONFIG_MEASURE_DEVICETREE=n
CONFIG_MEASURE_IGNORE_LOG=n
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_CHROMEOS=n
CONFIG_CHROMEOS_VBOOT=n
CONFIG_RAMBOOT_PBL=n
CONFIG_SYS_BOOT_RAMDISK_HIGH=y
CONFIG_DISTRO_DEFAULTS=n
#Update Update support
CONFIG_UPDATE_COMMON=y
CONFIG_UPDATE_TFTP=n
CONFIG_UPDATE_TFTP_CNT_MAX=0
CONFIG_UPDATE_TFTP_MSEC_MAX=100
CONFIG_UPDATE_LOAD_ADDR=0x100000
CONFIG_UPDATE_FIT=y
CONFIG_ANDROID_AB=n
# unset OPTEE
CONFIG_TEE=n
CONFIG_OPTEE=n
COMFIG_CMD_BOOTI=n
CONFIG_SPL_OPTEE_IMAGE=n
# use default.env
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_DEFAULT_ENV_FILE="default.env"
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
CONFIG_ENV_IS_IN_SPI_FLASH=n
# Enable wget
CONFIG_CMD_WGET=y
CONFIG_NET_LWIP=y
CONFIG_PROT_TCP_SACK=y
# Millscenous options requiered
CONFIG_LMB=y
# Enable SPI
CONFIG_MXC_SPI=y
CONFIG_CMD_SPI=y
CONFIG_DM_SPI=y
CONFIG_DEFAULT_SPI_BUS=0
CONFIG_DEFAULT_SPI_MODE=0


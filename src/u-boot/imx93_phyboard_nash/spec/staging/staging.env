# required
baudrate=115200
bootargs=console=ttymxc0,115200 root=/dev/ram ip=dhcp rdinit=/linuxrc
bootm_size=0x10000000
bootstopkeysha256=0
emmc_dev=2
ethact=ethernet@30bf0000
ethprime=eth1
fastboot_dev=mmc2
fdt_addr=0x43000000
img_current=image.itb
loadaddr=0x4C000000

# boot commands
bootcmd=run bootcmd_net
# boot from next_server provided by dhcp
bootcmd_net=dhcp; bootm
# boot from tftp server
bootcmd_tftp=dhcp ; tftpboot ${loadaddr} ${serverip}:${bootfile} ; bootm
# boot from http
bootcmd_http=env set autoload no; dhcp ; wget ${loadaddr} ${serverip}:/${bootfile} ; bootm
# boot from eMMC & SD-card
bootcmd_emmc=load mmc 2:1 ${loadaddr} ${img_current}; bootm
bootcmd_sd=load mmc 1:1 ${loadaddr} ${img_current}; bootm

# required
autoload=no
baudrate=115200
bootargs=console=ttyLP0,115200 earlycon root=/dev/ram ip=dhcp rdinit=/linuxrc
bootm_size=0x10000000
bootstopkeysha256=0
console=ttyLP0
emmc_dev=0
ethact=ethernet@30bf0000
ethprime=eth1
fdt_addr_r=0x90000000
img_current=image.itb
loadaddr=0x90000000
startwdt=wdt dev watchdog@42490000; wdt start 60000

# boot commands
bootcmd=run bootcmd_http
# fastboot - uncomment this line to override the default fastboot's behavior
#bootcmd_mfg=run bootcmd_http
# boot from tftp server
bootcmd_tftp=env set autoload no; dhcp ; tftpboot ${loadaddr} ${serverip}:${bootfile} ; bootm
# enable watchdog before tftp boot
bootcmd_wdt_tftp=run startwdt; run bootcmd_tftp
# boot from http
bootcmd_http=env set autoload no; dhcp ; wget ${loadaddr} ${serverip}:/${bootfile} ; bootm
# enable watchdog before http boot
bootcmd_wdt_http=run startwdt; run bootcmd_http
# boot from eMMC & SD-card
bootcmd_emmc=load mmc 2:1 ${loadaddr} ${img_current}; bootm
bootcmd_sd=load mmc 1:1 ${loadaddr} ${img_current}; bootm

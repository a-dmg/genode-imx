# required
baudrate=115200
bootargs=console=ttymxc0,115200 root=/dev/ram ip=dhcp rdinit=/linuxrc
bootm_size=0x10000000
bootstopkeysha256=0
emmc_dev=2
ethact=ethernet@30bf0000
ethprime=eth1
fdt_addr=0x43000000
img_current=image.itb
loadaddr=0x4C000000

# boot command
bootcmd=load mmc 1:1 ${loadaddr} ${img_current}; bootm
